{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:deploy": "ng build && node scripts/copy-to-fm-module.mjs",
    "watch": "ng build --watch --configuration development",
