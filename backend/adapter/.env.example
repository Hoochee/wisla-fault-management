# Server
PORT=8081
ADAPTER_VERSION=1.0.0

# PostgreSQL (wisla_fm_adapter)
DATABASE_URL=jdbc:postgresql://localhost:5432/wisla_fm_adapter
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# fm-module integration
FM_MODULE_BASE_URL=http://localhost:8080
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Kafka raw-event ingest
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_EVENTS_TOPIC=fm.raw-events

# Adapter limits
MAX_PAYLOAD_BYTES=1048576
BUFFER_RETRY_BASE_SECONDS=30
BUFFER_RETRY_INTERVAL_MS=60000
FM_MODULE_HEALTH_CHECK=true
